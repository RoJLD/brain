{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RoJLD/brain/schemas/permissions.schema.json",
  "title": "permissions.yaml",
  "description": "The permission hierarchy of a brain (brain.permissions, docs/permissions.md): its sections and a rule's keys, as brain.permissions reads them. It describes the format for brain schema diff and the fixtures (wi-brain-permissions-schema); brain.permissions still reads the file itself (its keys are its constants: SECTIONS, RULE_KEYS, NEVER_KEYS), and a test keeps the two in step. What it cannot say in this subset (exactly one of allow, ask or deny; one level at a time) brain.permissions checks.",
  "type": "object",
  "required": ["v"],
  "additionalProperties": false,
  "properties": {
    "v": {"const": 1, "description": "The format's version."},
    "never": {
      "type": "object",
      "description": "The categories no level may allow, extended by this file: category -> its patterns, why, deny rules and probes.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {"why": {}, "find": {}, "names": {}, "deny": {}, "probes": {}}
      }
    },
    "profiles": {"type": "object", "additionalProperties": {"$ref": "#/$defs/titled"}},
    "machines": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "required": ["title"], "additionalProperties": false,
        "properties": {"title": {"$ref": "#/$defs/text"}, "profile": {"type": "string"}}
      }
    },
    "tenants": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "required": ["title"], "additionalProperties": false,
        "properties": {"title": {"$ref": "#/$defs/text"}, "projects": {"type": "array", "items": {"type": "string"}}}
      }
    },
    "sessions": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "required": ["title"], "additionalProperties": false,
        "properties": {"title": {"$ref": "#/$defs/text"}, "project": {"type": "string"}, "parent": {"type": "string"}}
      }
    },
    "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "titled": {
      "type": "object", "required": ["title"], "additionalProperties": false,
      "properties": {"title": {"$ref": "#/$defs/text"}}
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "description": "One rule: one verdict (allow, ask or deny) and its pattern, at most one level's selector (project with machine is the local level), why, and its provenance.",
      "properties": {
        "allow": {"type": "string"}, "ask": {"type": "string"}, "deny": {"type": "string"},
        "profile": {}, "machine": {}, "tenant": {}, "project": {}, "session": {},
        "why": {"type": "string"}, "by": {}, "from": {}, "date": {}, "until": {}, "while": {}, "asked_by": {},
        "for": {}
      }
    }
  }
}
